  class StrategyBacktester:
      """策略回测引擎"""

      def __init__(self, initial_capital=100000):
          self.initial_capital = initial_capital
          self.portfolio = Portfolio(initial_capital)

      def run_backtest(self, strategy, data, start_date, end_date):
          """执行回测"""
          results = {
              'total_return': 0,
              'sharpe_ratio': 0,
              'max_drawdown': 0,
              'win_rate': 0,
              'trades': []
          }

          for date in pd.date_range(start_date, end_date):
              signals = strategy.generate_signals(data, date)
              self.portfolio.update(signals, date)

          return self.calculate_metrics()

      def calculate_metrics(self):
          """计算绩效指标"""
          returns = self.portfolio.get_returns()
          return {
              'total_return': (self.portfolio.value / self.initial_capital - 1) * 100,
              'sharpe_ratio': returns.mean() / returns.std() * np.sqrt(252),
              'max_drawdown': self.calculate_max_drawdown(),
              'calmar_ratio': self.calculate_calmar_ratio()
          }

