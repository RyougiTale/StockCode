  # 新建 lightweight_model.py
  class EfficientStockPredictor(nn.Module):
      """轻量级股票预测模型，参数量减少80%"""
      def __init__(self, feature_sizes, hidden_dim=64):
          super().__init__()

          # 使用共享LSTM编码器
          self.shared_lstm = nn.LSTM(
              input_size=max(feature_sizes.values()),
              hidden_size=hidden_dim,
              num_layers=2,
              batch_first=True,
              dropout=0.2
          )

          # 时间尺度适配器
          self.scale_adapters = nn.ModuleDict({
              scale: nn.Linear(feature_sizes[scale], hidden_dim)
              for scale in ['daily', 'weekly', 'monthly']
          })

          # 注意力融合机制
          self.attention_fusion = nn.MultiheadAttention(
              hidden_dim, num_heads=4, batch_first=True
          )

          self.classifier = nn.Linear(hidden_dim, 5)

