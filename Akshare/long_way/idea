  # 改进 rolling_scaler.py
  class AdaptiveWindowScaler:
      """自适应窗口大小的归一化器"""

      def __init__(self, volatility_threshold=0.02):
          self.vol_threshold = volatility_threshold

      def adaptive_window_size(self, data):
          """根据市场波动性调整窗口大小"""
          recent_vol = data['close'].pct_change().rolling(30).std().iloc[-1]

          if recent_vol > self.vol_threshold * 2:
              return 126  # 高波动期使用较短窗口
          elif recent_vol < self.vol_threshold * 0.5:
              return 504  # 低波动期使用较长窗口
          else:
              return 252  # 正常窗口

