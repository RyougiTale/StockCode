  # 新建 lightweight_model.py
  class EfficientStockPredictor(nn.Module):
      """轻量级股票预测模型，参数量减少80%"""
      def __init__(self, feature_sizes, hidden_dim=64):
          super().__init__()

          # 使用共享LSTM编码器
