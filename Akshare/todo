# A. 波动性感知层
class VolatilityAwareEncoder(nn.Module):
    def __init__(self, base_encoder, volatility_dim=1):
        self.base_encoder = base_encoder
        self.volatility_gate = nn.Linear(volatility_dim, d_model)
    
    def forward(self, x, volatility):
        base_output = self.base_encoder(x)
        vol_gate = torch.sigmoid(self.volatility_gate(volatility))
        return base_output * vol_gate

# B. 多专家混合模型
class MixtureOfExperts(nn.Module):
    # 不同专家处理不同波动性的股票
    def __init__(self, num_experts=3):
        self.experts = nn.ModuleList([Expert() for _ in range(num_experts)])
        self.gating = nn.Linear(input_dim, num_experts)

# C. 注意力机制
class VolatilityAttention(nn.Module):
    # 根据波动性动态调整特征权重
    def forward(self, features, volatility):
        attention_weights = self.attention_layer(volatility)
        return features * attention_weights


